# Frontend environment variables for Authentication app
# Copy this file to .env and fill in the values. Do NOT commit .env.

# Supabase project URL and anon key
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key

# Public site URL used in auth redirects (set by deployment)
REACT_APP_SITE_URL=http://localhost:3000

# Backend API base URL (optional; can be used by API layer)
REACT_APP_API_BASE_URL=http://localhost:3001
