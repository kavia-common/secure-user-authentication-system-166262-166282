# React Frontend - .env.example
# Copy to .env and set values for your environment.

# Backend URL (REQUIRED - ensure this points to your FastAPI backend origin)
# Example for local dev:
# REACT_APP_BACKEND_URL=http://localhost:8000
# Example for hosted preview (replace with your actual backend URL):
REACT_APP_BACKEND_URL=

# Optional: If you use the Supabase client in the browser (not required for basic flows)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Site URL for auth redirects/magic links (used by helper functions if enabled)
# In development this can be http://localhost:3000
REACT_APP_SITE_URL=http://localhost:3000
