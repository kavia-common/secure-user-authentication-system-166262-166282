# Frontend environment variables

# Base URL of FastAPI backend (e.g., http://localhost:8000)
REACT_APP_BACKEND_URL=

# Supabase configuration (optional if backend handles all auth server-side)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Used for constructing emailRedirectTo links when using Supabase auth emails
# For local dev this can be http://localhost:3000
REACT_APP_SITE_URL=
