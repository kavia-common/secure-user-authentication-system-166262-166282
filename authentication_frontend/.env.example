# Frontend environment configuration for React app
# IMPORTANT: Do NOT commit real secrets. Copy this file to .env and fill in values.

# PUBLIC_INTERFACE
# Backend base URL (FastAPI). MUST be set; otherwise requests will go to the frontend origin and return HTML.
# Example (local): http://localhost:8000
# Example (this environment backend): https://vscode-internal-34468-beta.beta01.cloud.kavia.ai:3001
REACT_APP_BACKEND_URL=

# Supabase (optional for client-side usage)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=

# Site URL, used for email redirects if integrating Supabase auth flows
# e.g. http://localhost:3000
REACT_APP_SITE_URL=
