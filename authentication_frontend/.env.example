# Frontend environment variables for Kavia preview environment

# URL of the FastAPI backend service (Kavia preview service name + port)
REACT_APP_BACKEND_URL=http://authentication_backend:3001

# Public site URL for the frontend (used for Supabase email redirects, etc.)
REACT_APP_SITE_URL=http://authentication_frontend:3000

# Optional Supabase configuration (leave empty or set via deployment)
REACT_APP_SUPABASE_URL=
REACT_APP_SUPABASE_ANON_KEY=
